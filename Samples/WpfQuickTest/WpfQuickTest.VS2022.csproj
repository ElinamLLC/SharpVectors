<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFrameworks>net40;net45;net46;net47;net48;net6.0-windows;net8.0-windows;net9.0-windows</TargetFrameworks>
		<UseWPF>true</UseWPF>
		<AppConfig Condition="'$(TargetFramework)' == 'net40'">App.net40.config</AppConfig>
		<AutoUnifyAssemblyReferences Condition="'$(TargetFramework)' == 'net40'">false</AutoUnifyAssemblyReferences>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\SharpVectorConvertersWpf\SharpVectors.Converters.Wpf.VS2022.csproj" />
		<ProjectReference Include="..\..\Source\SharpVectorCore\SharpVectors.Core.VS2022.csproj" />
		<ProjectReference Include="..\..\Source\SharpVectorCss\SharpVectors.Css.VS2022.csproj" />
		<ProjectReference Include="..\..\Source\SharpVectorDom\SharpVectors.Dom.VS2022.csproj" />
		<ProjectReference Include="..\..\Source\SharpVectorModel\SharpVectors.Model.VS2022.csproj" />
		<ProjectReference Include="..\..\Source\SharpVectorRenderingWpf\SharpVectors.Rendering.Wpf.VS2022.csproj" />
		<ProjectReference Include="..\..\Source\SharpVectorRuntimeWpf\SharpVectors.Runtime.Wpf.VS2022.csproj" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net40'">
		<PackageReference Include="Microsoft.Bcl.Async" Version="1.0.168" />
	</ItemGroup>

</Project>
